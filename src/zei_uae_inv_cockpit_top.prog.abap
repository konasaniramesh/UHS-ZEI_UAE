  BEGIN OF ty_j_party_wrap,
    party TYPE ty_j_party,
  END OF ty_j_party_wrap,
  BEGIN OF ty_j_taxcat,
    id                        TYPE string,
    percent                   TYPE string,      "string in Postman ("5")
    tax_exemption_reason      TYPE string,
    tax_exemption_reason_code TYPE string,
    tax_scheme                TYPE ty_j_id,
