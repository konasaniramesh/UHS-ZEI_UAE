    line_ext_amt_cur             TYPE string, "line_extension_amount_currency_code
    tax_exclusive_amount         TYPE ty_j_amt,
    tax_excl_amt_cur             TYPE string, "tax_exclusive_amount_currency_code
    tax_inclusive_amount         TYPE ty_j_amt,
    tax_incl_amt_cur             TYPE string, "tax_inclusive_amount_currency_code
    allowance_total_amount       TYPE ty_j_amt,
