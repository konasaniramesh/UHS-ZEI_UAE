"----------------------------------------------------------------------
" TaxLab UAE e-invoicing (JSON) - mirrors the Postman collection
" 'TaxLab - UAE Invoice APIs' (Submit Invoice Documents, shape 2)
" Component names = JSON keys in snake_case. Keys longer than 30
" characters use a short ABAP name + LCL_APP=>JSON_NAME_MAP.
"----------------------------------------------------------------------
TYPES:
  ty_j_amt TYPE p LENGTH 16 DECIMALS 2,
  ty_j_qty TYPE p LENGTH 16 DECIMALS 3,
  BEGIN OF ty_j_id,
    id TYPE string,
  END OF ty_j_id,
  BEGIN OF ty_j_name,
    name TYPE string,
  END OF ty_j_name,
  BEGIN OF ty_j_country,
    identification_code TYPE string,
  END OF ty_j_country,
  BEGIN OF ty_j_addr_line,
    line TYPE string,
  END OF ty_j_addr_line,
  BEGIN OF ty_j_address,
    street_name            TYPE string,
    additional_street_name TYPE string,
    city_name              TYPE string,
    postal_zone            TYPE string,
    country_subentity      TYPE string,
    address_line           TYPE ty_j_addr_line,
    country                TYPE ty_j_country,
  END OF ty_j_address,
  BEGIN OF ty_j_party_tax,
    company_id TYPE string,
    tax_scheme TYPE ty_j_id,
  END OF ty_j_party_tax,
  BEGIN OF ty_j_legal,
    registration_name  TYPE string,
    company_id         TYPE string,
    company_scheme_id  TYPE string,
    scheme_agency_name TYPE string,
    scheme_agency_id   TYPE string,
